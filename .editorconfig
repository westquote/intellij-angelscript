root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# The Kotlin coding conventions, as IntelliJ IDEA applies them.
ktlint_code_style = intellij_idea
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[src/test/testData/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
